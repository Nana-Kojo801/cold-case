# Meta Model API key (server only, never exposed to the browser). Create one at https://dev.meta.ai/
MODEL_API_KEY=

# Optional model overrides (defaults shown, confirmed against https://dev.meta.ai/docs/models)
# MODEL_WONDER=muse-wonder-1.0
# MODEL_SPARK=muse-spark-1.1
# MODEL_IMAGE=muse-image-1.0
# MODEL_SAM=sam-3.1
# MODEL_ASR=muse-voice-transcribe-1.0

# Which model plays the suspects live: "wonder" (default) or "spark" if Wonder is too slow
# SUSPECT_MODEL=wonder

# Reasoning effort per job: minimal | low | medium | high
# EFFORT_CASE=medium
# EFFORT_SUSPECT=low
# EFFORT_ANALYSIS=low
# EFFORT_DEBRIEF=low

# Rate limits (per IP per minute; per IP per day and global per day for the costly routes)
# RL_PER_MINUTE=40
# RL_CASE_IP_DAY=8
# RL_CASE_GLOBAL_DAY=200
# RL_IMAGE_IP_DAY=90
# RL_IMAGE_GLOBAL_DAY=2000
# RL_TURN_IP_DAY=400
# RL_TURN_GLOBAL_DAY=10000
